.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .netlisp,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x706fd33d5a329eb6, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.17.0-dev.1683+5ceec001b",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        // Vendored from httpz's Zig-development branch at
        // e6c23eb959e20bc8871184622fa9082ddaf5b106. This branch includes the
        // deferred-signal and loop-thread fd-deregistration fixes previously
        // backported into our Zig-0.15 fork, plus the later shutdown-UAF and
        // timeout-sweep fixes. Keep the commit exact: this event loop shares a
        // process with netlisp's fork-heavy MCP autocommit path.
        .httpz = .{
            .path = "vendor/httpz",
        },
        // Guardian (code-quality gate, MIT) runs on EVERY build, so this dep is
        // load-bearing for `zig build`, not optional tooling. Pinned by
        // `.url`+`.hash` to a tagged release of the public repo
        // github.com/eugenepentland/guardian-zig, so a fresh clone builds with
        // nothing beside it: the first build downloads the tarball once (the
        // only network access the build needs — `zig build --fetch` gets it
        // ahead of time), then Zig's global cache serves every later build
        // offline.
        //
        // Developing against a LOCAL guardian checkout, no zon edit needed:
        //
        //   zig build --system <dir>
        //
        // where <dir> holds one entry per fetched package named exactly as its
        // hash, e.g.
        // `ln -s ~/ai/canopy/guardian-zig <dir>/guardian-0.2.1-<hash>`.
        // `--system` resolves packages by directory name only — no hash
        // verification — so the link may point at a dirty working tree.
        // Guardian is the only URL dep here; everything else is vendored or a
        // path dep, so that one entry is the whole override. Bump the pin by
        // tagging guardian-zig and re-running
        // `zig fetch --save=guardian <tarball-url>` (with this entry deleted
        // first — `--save` over an existing entry rewrites the value in place
        // and drops the hash).
        .guardian = .{
            .url = "https://github.com/eugenepentland/guardian-zig/archive/refs/tags/v0.2.1.tar.gz",
            .hash = "guardian-0.2.1-Qv8iu_GLPQBNOe5Zp3pE9AGxcf6Bxfm4dtwCaa6iaYyN",
        },
        // Latest upstream main at migration time, vendored so the small Zig
        // master compatibility delta is durable and reviewed with this tree.
        .zt = .{ .path = "vendor/zt" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // httpz, websocket, metrics, and zt are intentionally vendored at
        // exact revisions so a clean package build never follows moving Zig
        // master dependencies or needs network access.
        "vendor",
        // Needed by the `gen-language-docs --check` build step (compares the
        // committed reference against the dispatch tables) and by Guardian,
        // both of which run on a packaged build — omitting them makes a fetched
        // package fail its own checks.
        "docs",
        "guardian.toml",
        // For example...
        //"LICENSE",
        //"README.md",
    },
}
