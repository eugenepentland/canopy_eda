#!/usr/bin/env bash
# Run the pinned production Zig compiler (the self-hosted-backend compiler the
# release pipeline deploys with). The path is read from prepare-release.sh so
# the pin has exactly one source of truth; the SHA check mirrors the release
# boundary so a stale or swapped package fails loudly here instead of during a
# deploy.
#
# Usage: scripts/zig-prod <any zig arguments>
# Example: scripts/zig-prod build --seed=1 -Doptimize=safe -p ~/.cache/netlisp/prod/my-server
#
# Install prefixes belong under ~/.cache/netlisp/prod/, NOT /tmp: /tmp carries
# a per-user quota here, and accumulated throwaway prefixes filled it once
# (2026-08-26), which breaks every tool that needs tmpfile space. Clean old
# prefixes with: rm -rf ~/.cache/netlisp/prod/<prefix>
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PREPARE="$ROOT/.githooks/prepare-release.sh"

PROD_ZIG="$(grep -m1 '^PRODUCTION_ZIG=' "$PREPARE" | cut -d'"' -f2)"
WANT_SHA="$(grep -m1 '^REQUIRED_ZIG_SHA256=' "$PREPARE" | cut -d'"' -f2)"

if [ ! -x "$PROD_ZIG" ]; then
  echo "zig-prod: pinned compiler missing or not executable: $PROD_ZIG" >&2
  exit 1
fi
GOT_SHA="$(sha256sum "$PROD_ZIG" | awk '{print $1}')"
if [ "$GOT_SHA" != "$WANT_SHA" ]; then
  echo "zig-prod: compiler SHA mismatch at $PROD_ZIG" >&2
  echo "  required: $WANT_SHA" >&2
  echo "  found:    $GOT_SHA" >&2
  exit 1
fi

exec "$PROD_ZIG" "$@"
