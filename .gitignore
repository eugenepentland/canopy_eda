zig-out/
# The LIVE production executable (deploy-prod.sh installs it here). Kept out
# of zig-out/ so a plain `zig build` cannot overwrite what prod runs.
.deploy/
# Debug-binary side installs (zig build -p zig-out-dbg); a 200 MB Debug
# netlisp was once committed from here by a path-scoped commit sweep.
zig-out-dbg/
zig-out-browser-perf/
.zig-cache
# Isolated per-task build caches (agents pass --cache-dir .zig-cache-<tag>)
.zig-cache-*/
# Zig's local package directory: every build root that resolves a `.url`+`.hash`
# dependency (guardian) gets one unpacked here. Cache-shaped and reproducible
# from build.zig.zon, and it must not leave `git status` dirty on main.
/zig-pkg/
*.o
*.swp
*~
# No trailing slash: a worktree points this at the shared checkout's install
# via a symlink (perf_gate.sh checks node_modules/playwright literally), and
# the directory-only pattern left that symlink untracked-dirty, which
# prepare-release refuses.
/node_modules
/test-results/

# Python bytecode
__pycache__/
*.pyc

# Board-specific design data — the user's projects, not the netlisp tool itself.
# Everything under projects/ (designs, libraries, history, reviews, OAuth
# state, edit history) lives on disk but is not tracked. The tracked tool is
# src/, build.zig, SPEC.md, docs/, etc.
/projects/

# Guardian runtime database
guardian_runtime.db

# Guardian per-build input cache (regenerated by every build)
.guardian/cache/

# Loose root-level scratch files
/ADC.md
/ad7380-4.pdf

# Reasonix local metadata
/.reasonix/
/reasonix.toml

# Claude Code worktree metadata (per-machine; not part of the project)
.claude/worktrees/
# Machine-local symlink for the guardian path dep (see build.zig.zon)
.claude/canopy
# Per-machine scheduler lock written by the local agent runtime
.claude/scheduled_tasks.lock

# Local credentials for outbound part-data APIs (see .env.example)
.env
