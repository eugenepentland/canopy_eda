zig-out/
# The LIVE production executable (deploy-prod.sh installs it here). Kept out
# of zig-out/ so a plain `zig build` cannot overwrite what prod runs.
.deploy/
# Debug-binary side installs (zig build -p zig-out-dbg); a 200 MB Debug
# netlisp was once committed from here by a path-scoped commit sweep.
zig-out-dbg/
.zig-cache
# Isolated per-task build caches (agents pass --cache-dir .zig-cache-<tag>)
.zig-cache-*/
*.o
*.swp
*~

# Python bytecode
__pycache__/
*.pyc

# Board-specific design data — the user's projects, not the eda tool itself.
# Everything under projects/ (designs, libraries, history, reviews, OAuth
# state, edit history) lives on disk but is not tracked. The tracked tool is
# src/, build.zig, SPEC.md, docs/, etc.
/projects/

# Guardian runtime database
guardian_runtime.db

# Guardian per-build input cache (regenerated by every build)
.guardian/cache/

# Loose root-level scratch files
/ADC.md
/ad7380-4.pdf

# Reasonix local metadata
/.reasonix/
/reasonix.toml

# Claude Code worktree metadata (per-machine; not part of the project)
.claude/worktrees/
# Machine-local symlinks for the ward path dep (see build.zig.zon)
.claude/ward
.claude/canopy

# Local credentials for outbound part-data APIs (see .env.example)
.env
