;; Odd pins in column 1 (x = 0), even pins in column 2 (x = 2.54 mm),
;; incrementing away from pin 1 — the usual dual-row numbering.
(component "pin-header-2x5"
  (description "2x5 (10-pin) 2.54 mm (0.1 in) through-hole pin header, dual row")
  (pinout pin-header-2x5)
  (footprint pin-header-2x5-2-54mm)
  (refdes "J")
  (ignore-requirements))
