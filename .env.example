# Environment for `netlisp serve`. Copy to `.env` (gitignored) and fill in.
#
# Every key below is read by the code: the credential/tunable keys go through
# `src/config.zig` (the one module allowed to touch the environment, so the
# `ban-env` policy holds), and `EDA_AUTH_DIR` through `src/main.zig`. Real
# environment variables win over values here, an empty value counts as unset,
# and this file is the contract — a key documented here that nothing reads is
# a bug, not a courtesy.

# ── Part sourcing: Component Search Engine ────────────────────────────────
# HTTP Basic credentials for your componentsearchengine.com account, used by
# the `download_footprint` MCP tool and nothing else — CSE's suggestion API
# (search / part resolution / datasheet lookup) needs no auth, so
# `download_datasheet` works without these. Both are required together:
# download_footprint fails closed with "set CSE_EMAIL + CSE_PASSWORD in .env
# for part sourcing", or "CSE_EMAIL is set but CSE_PASSWORD is empty" when
# only the password is missing.
CSE_EMAIL=
CSE_PASSWORD=

# ── Part sourcing: DigiKey Product Information API ────────────────────────
# OAuth2 client credentials. Without them the `resolve_mpn` / `check_stock` /
# `search_components` MCP tools have no DigiKey backend to query.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Optional API base-URL override, e.g. the sandbox host. Unset = the
# production host. This is the ONLY sandbox switch; there is no DIGIKEY_ENV.
# DIGIKEY_API_BASE=https://sandbox-api.digikey.com

# ── Part-sourcing rate limits (optional; defaults shown) ──────────────────
# Minimum spacing between outbound call STARTS, in milliseconds, and the cap on
# calls in flight at once. Unset or unparseable falls back to the default.
# CSE_MIN_INTERVAL_MS=200
# CSE_MAX_IN_FLIGHT=2
# DIGIKEY_MIN_INTERVAL_MS=250
# DIGIKEY_MAX_IN_FLIGHT=2

# ── Auth (ward) ──────────────────────────────────────────────────────────
# netlisp is a pure resource server; auth is delegated to the wardd auth
# server. If any WARD_* URL is unset, protected requests FAIL CLOSED (503) —
# except the NETLISP_DEV loopback dev bypass, which needs no wardd.

# Verify a browser `ward_session` cookie (LAN-side wardd endpoint). Unset ⇒
# every session-gated page request fails closed.
WARD_VERIFY_URL=http://127.0.0.1:9000/verify
# Where browsers without a session are redirected to sign in (public URL).
WARD_LOGIN_URL=https://ward.eugenepentland.dev/login
# Optional: explicit RFC 9728 authorization-server base for the protected-resource
# metadata. Defaults to stripping the trailing "/login" off WARD_LOGIN_URL, so
# only set this when the login URL does not end in "/login".
# WARD_AUTH_SERVER_URL=https://ward.eugenepentland.dev
# Introspect MCP/API bearer tokens (LAN-only wardd endpoint). Unset ⇒ the
# bearer path fails closed rather than admit an unverifiable token, so the
# whole MCP surface is unreachable.
WARD_INTROSPECT_URL=http://127.0.0.1:9000/oauth/introspect
# Service name a bearer's scope must contain to be accepted here.
WARD_SERVICE_NAME=eda
# Browsable URL sent as X-Ward-Service-Url, so ward's home page links this
# app in the signed-in user's app list instead of naming it as plain text.
WARD_SERVICE_URL=https://co-circuit.eugenepentland.dev
# Verdict-cache TTL in seconds — the upper bound on revocation lag. Unset,
# zero or non-numeric falls back to the caller's default (30).
WARD_CACHE_TTL_SECS=30

# ── Local development ─────────────────────────────────────────────────────
# Any non-empty value grants a local admin identity to a loopback, unproxied
# request, so no wardd is needed for development. Never set in production.
# NETLISP_DEV=1

# ── Server behaviour ──────────────────────────────────────────────────────
# Per-mutation git auto-commit of MCP design edits, on by default when
# --project-dir is a git checkout. Only a bare `0` disables it; any other
# value (including unset) leaves it enabled.
# NETLISP_GIT_AUTOCOMMIT=0

# Directory holding the auth sidecars (plugin tokens). Resolution order is the
# `netlisp serve --auth-dir <path>` flag, then this variable, then
# `<project-dir>/auth`. Useful when several worktrees share one project dir.
# EDA_AUTH_DIR=/var/lib/netlisp/auth
