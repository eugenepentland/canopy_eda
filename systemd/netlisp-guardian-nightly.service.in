# Guardian nightly gate for the netlisp repo — MAINTAINER INFRASTRUCTURE.
#
# This is a TEMPLATE, not a unit: `@TOP@` is substituted with the checkout path
# by `.githooks/install.sh --guardian-nightly`, which writes the rendered unit
# to ~/.config/systemd/user/ and enables the timer. Nothing about netlisp needs
# it — it is the owner's box running the expensive nightly tier so the day's
# commits do not have to. See .githooks/README.md.
#
# What it does: runs Guardian's full nightly tier against this checkout —
#   1. `zig build`        — the whole `all` check suite in baseline mode.
#   2. `zig build mutate-full` — whole-tree mutation testing that ratchets the
#      kill score in .guardian/mutation.txt (the score can only ever climb;
#      a nightly drop fails the unit). This is the guardian-check `nightly`
#      tier expressed as two build steps, so it needs no prebuilt
#      guardian-check binary path — just the repo's own `zig build`.
# The `&&` gates step 2 on a green step 1: a red build never ratchets mutation.
# Both commands are internal validation and therefore stay self-hosted Debug;
# this nightly must never request ReleaseSafe/LLVM. Deployment owns that mode.
#
# Install / enable (user-level, matching netlisp.service — this repo's units run
# under `systemctl --user`):
#   .githooks/install.sh --guardian-nightly
# Inspect results:   journalctl --user -u netlisp-guardian-nightly.service
# Run once by hand:  systemctl --user start netlisp-guardian-nightly.service
# The mutation-score ratchet it maintains lives in .guardian/mutation.txt
# (committed); commit any bump it produces.

[Unit]
Description=Guardian nightly gate (all suite + whole-tree mutation ratchet) for netlisp
After=network.target

[Service]
Type=oneshot
WorkingDirectory=@TOP@
# Login shell (-l) so the user's PATH resolves `zig` — which must be the one
# pinned compiler from .zigversion (scripts/install-zig.sh --link puts it
# there). Deliberately NOT an absolute toolchain path: that spelling pinned one
# machine's private install into a tracked file and went stale on every bump.
ExecStart=/bin/sh -lc 'cd @TOP@ && zig build --seed=1 && zig build --seed=1 mutate-full'
# A whole-tree mutation run is sequential and long; the systemd default
# (~90s) would kill it. Cap generously instead of disabling the guard.
TimeoutStartSec=6h
