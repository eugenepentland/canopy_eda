[Unit]
Description=Netlisp schematic/PCB web server
After=network.target
# Crash-loop guard: if the service dies >10 times in 5 min, stop retrying and
# leave it failed. `systemctl --user reset-failed netlisp.service` clears the
# limit; deploy-prod.sh does this before a rollback.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/epentland/ai/canopy/eda
# Release candidates are built, compiler-SHA checked, tested, checksummed, and
# installed atomically by deploy-prod.sh. The service only runs that artifact;
# it must never rebuild an unchecked binary during restart or host boot.
Environment=NETLISP_GIT_AUTOCOMMIT=0
# netlisp binds 127.0.0.1 and admits only a loopback, unproxied request; a
# request that arrives through a reverse proxy (any `X-Forwarded-*` header) is
# answered 403. The shipped unit is therefore LOCAL-ONLY. To serve a public URL,
# put an authenticating proxy in front of this port and add `--allow-remote`
# to ExecStart (before `--port`): with that flag EVERY request netlisp receives
# is an admin, so it is correct only while the proxy authenticates callers —
# see docs/auth.md.
# For Ward hosting, use the persistent drop-in shown in
# systemd/netlisp-ward.conf.example instead of changing ExecStart.
ExecStart=/home/epentland/ai/canopy/eda/.deploy/bin/netlisp serve --project-dir /home/epentland/ai/canopy/eda/projects/designs --port 7050
# `always` also recovers from signals systemd classifies as clean exits, while
# still honoring an explicit `systemctl --user stop`.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
