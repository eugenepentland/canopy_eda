(kicad_pcb (version 20240108) (generator "netlisp-browser-perf")
  (general (thickness 1.6))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user))
  (net 0 "")
  (net 1 "PERF_01")
  (net 2 "PERF_02")
  (net 3 "PERF_03")
  (net 4 "PERF_04")
  (net 5 "PERF_05")
  (net 6 "PERF_06")
  (net 7 "PERF_07")
  (net 8 "PERF_08")

  ; Eight deliberately crossed point-to-point nets make this a real routing
  ; workload while keeping it deterministic and small enough for every commit.
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 4)
    (property "Reference" "J1") (property "Value" "PERF_01_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 1 "PERF_01")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 25)
    (property "Reference" "J2") (property "Value" "PERF_01_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 1 "PERF_01")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 7)
    (property "Reference" "J3") (property "Value" "PERF_02_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 2 "PERF_02")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 22)
    (property "Reference" "J4") (property "Value" "PERF_02_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 2 "PERF_02")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 10)
    (property "Reference" "J5") (property "Value" "PERF_03_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 3 "PERF_03")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 19)
    (property "Reference" "J6") (property "Value" "PERF_03_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 3 "PERF_03")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 13)
    (property "Reference" "J7") (property "Value" "PERF_04_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 4 "PERF_04")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 16)
    (property "Reference" "J8") (property "Value" "PERF_04_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 4 "PERF_04")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 16)
    (property "Reference" "J9") (property "Value" "PERF_05_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 5 "PERF_05")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 13)
    (property "Reference" "J10") (property "Value" "PERF_05_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 5 "PERF_05")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 19)
    (property "Reference" "J11") (property "Value" "PERF_06_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 6 "PERF_06")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 10)
    (property "Reference" "J12") (property "Value" "PERF_06_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 6 "PERF_06")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 22)
    (property "Reference" "J13") (property "Value" "PERF_07_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 7 "PERF_07")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 7)
    (property "Reference" "J14") (property "Value" "PERF_07_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 7 "PERF_07")))

  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 4 25)
    (property "Reference" "J15") (property "Value" "PERF_08_A")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 8 "PERF_08")))
  (footprint "BrowserPerf:Terminal" (layer "F.Cu") (at 46 4)
    (property "Reference" "J16") (property "Value" "PERF_08_B")
    (pad "1" thru_hole circle (at 0 0) (size 1 1) (drill 0.45)
      (layers "*.Cu" "*.Mask") (net 8 "PERF_08")))

  ; Staggered non-plated holes add local obstacles in the central search lane.
  (footprint "BrowserPerf:MountingHole" (layer "F.Cu") (at 24 7)
    (property "Reference" "H1") (property "Value" "NPTH")
    (pad "" np_thru_hole circle (at 0 0) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask")))
  (footprint "BrowserPerf:MountingHole" (layer "F.Cu") (at 27 12)
    (property "Reference" "H2") (property "Value" "NPTH")
    (pad "" np_thru_hole circle (at 0 0) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask")))
  (footprint "BrowserPerf:MountingHole" (layer "F.Cu") (at 23 18)
    (property "Reference" "H3") (property "Value" "NPTH")
    (pad "" np_thru_hole circle (at 0 0) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask")))
  (footprint "BrowserPerf:MountingHole" (layer "F.Cu") (at 27 23)
    (property "Reference" "H4") (property "Value" "NPTH")
    (pad "" np_thru_hole circle (at 0 0) (size 2 2) (drill 1.2) (layers "*.Cu" "*.Mask")))

  ; Opposed top-layer keepout walls make the greedy pass search around them or
  ; change layers, while the bottom layer keeps the every-commit run bounded.
  (zone (layer "F.Cu")
    (keepout (tracks not_allowed) (vias not_allowed))
    (polygon (pts (xy 16 0) (xy 20 0) (xy 20 20.5) (xy 16 20.5))))
  (zone (layer "F.Cu")
    (keepout (tracks not_allowed) (vias not_allowed))
    (polygon (pts (xy 30 9.5) (xy 34 9.5) (xy 34 30) (xy 30 30))))

  (gr_rect (start 0 0) (end 50 30)
    (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts")))
