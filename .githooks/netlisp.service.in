[Unit]
Description=Netlisp schematic/PCB web server
After=network.target
# Crash-loop guard: if the service dies >10 times in 5 min, stop retrying and
# leave it failed (rather than hammering the CPU). `systemctl --user reset-failed
# netlisp.service` clears the limit; deploy-prod.sh does this before a rollback.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@TOP@
# Production batches all live-design persistence through the quiet-period
# checkpoint timer instead of making one commit per MCP tool call.
Environment=NETLISP_GIT_AUTOCOMMIT=0
# netlisp binds 127.0.0.1 and, on its own, admits only a loopback, unproxied
# request. This host serves the public URL through an authenticating reverse
# proxy, so every real request arrives with `X-Forwarded-*` set and would
# otherwise be answered 403. `--allow-remote` hands the auth decision to that
# proxy: with it, EVERY request netlisp receives is an admin. It is correct
# ONLY while something in front of this port is authenticating callers — see
# docs/auth.md. Remove it (and the proxy) and the server is local-only again.
ExecStart=@TOP@/.deploy/bin/netlisp serve --project-dir @TOP@/projects/designs --allow-remote --port @PORT@
# Restart=always, NOT on-failure (2026-07-25): systemd counts termination by
# SIGTERM/SIGINT/SIGHUP/SIGPIPE as a CLEAN exit, so `pkill netlisp` or
# `fuser -k @PORT@/tcp` (used to free the port for a worktree server) left prod
# dead-and-not-restarted for 7h while the public URL served 502. `always` still
# honours an explicit `systemctl --user stop`, so intentional stops work.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
